{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeni-sistem/sayfa.schema.json",
  "title": "Yeni Sistem sayfa frontmatter semasi",
  "description": "SEMA.md'nin makine okur karsiligi. kontrol.py her .md sayfasinin frontmatter'ini bu semaya gore dogrular. Turlere gore kosullu zorunlu alanlar 'allOf' altinda.",
  "type": "object",
  "required": ["id", "ad", "tur", "kat", "surum", "durum", "amac", "olusturma", "yazar", "talimat", "dayandigi", "besledigi"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[a-z0-9-]+$"},
    "ad": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "tur": {"type": "string", "enum": ["gozlem", "fikir", "yansima", "kavram", "arastirma-notu", "karar", "kural", "yonerge", "kapi", "bulgu", "eylem-plani", "gorev", "rol", "sop", "alan-paketi", "cikti", "kaynak", "referans", "anayasa", "moc", "ham"]},
    "kat": {"type": "integer", "enum": [0, 1, 2, 3, 4, 9]},
    "surum": {"type": ["string", "number"], "pattern": "^[0-9]+\\.[0-9]+$"},
    "durum": {"type": "string", "enum": ["taslak", "aktif", "onerildi", "kabul", "yerine-gecildi", "reddedildi", "arsiv"]},
    "amac": {"type": "string", "minLength": 15},
    "olusturma": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "guncelleme": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "son_gozden_gecirme": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "yazar": {"type": "string", "minLength": 2},
    "talimat": {"type": "string", "pattern": "^T-[0-9]{3,4}$"},
    "dayandigi": {"type": "array", "items": {"type": "string"}},
    "besledigi": {"type": "array", "items": {"type": "string"}},
    "ust": {"type": "string", "pattern": "MOC-[a-z-]+\\.md$"},
    "kaynaklar": {"type": "array", "items": {"type": "string"}},
    "alindi": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "guven": {"type": "string", "enum": ["dusuk", "orta", "yuksek"]},
    "onem": {"type": "integer", "minimum": 1, "maximum": 10},
    "merdiven": {"type": "integer", "minimum": 0, "maximum": 5},
    "cynefin": {"type": "string", "enum": ["acik", "karmasik", "kompleks", "kaotik", "karisik", "belirlenmedi"]},
    "kapi": {"type": "string", "enum": ["tek-yonlu", "cift-yonlu"]},
    "karar_veren": {"type": "string"},
    "sunset": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "dayanak": {"type": "string"},
    "sahip": {"type": "string"},
    "inceleyici": {"type": "string"},
    "kanban": {"type": "string", "enum": ["bekliyor", "basladi", "fiziksel-adim-bekliyor", "kontrol", "tamam", "iptal"]},
    "kanit": {"type": "array", "items": {"type": "object", "required": ["komut", "cikis"], "properties": {"komut": {"type": "string"}, "cikis": {"type": ["integer", "string"]}, "ozet": {"type": "string"}}}},
    "insan_noktalari": {"type": "array", "items": {"type": "object", "required": ["id", "tur", "kosul"], "properties": {"id": {"type": "string", "pattern": "^HP-[A-Z0-9-]+$"}, "tur": {"type": "string"}, "kosul": {"type": "string"}, "kanit": {"type": "string"}, "bekleyen_adim": {"type": ["string", "integer"]}}}},
    "bekci": {"type": "string"},
    "sonuc": {"type": "string", "enum": ["bekliyor", "go", "kill", "hold", "recycle"]},
    "saklama": {"type": "string", "enum": ["S", "K", "B", "I"]},
    "yerine_gecti": {"type": "string"},
    "yerine_gecen": {"type": "string"},
    "gecerli_baslangic": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "gecerli_bitis": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "etiketler": {"type": "array", "items": {"type": "string"}},
    "takma_adlar": {"type": "array", "items": {"type": "string"}},
    "oldurme_tarihi": {"type": "string"},
    "oldurme_nedeni": {"type": "string"},
    "dokunus_sayisi": {"type": "integer", "minimum": 0},
    "son_dokunus": {"type": "string"},
    "islendi": {"type": "boolean"},
    "islenme_tarihi": {"type": "string"},
    "sonuc_yol": {"type": "string"},
    "kaynak_turu": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"kat": {"enum": [1, 2, 3, 4]}, "tur": {"not": {"enum": ["moc", "anayasa", "referans"]}}}}, "then": {"required": ["ust"]}},
    {"if": {"properties": {"tur": {"enum": ["gozlem", "kaynak", "yansima", "arastirma-notu", "alan-paketi"]}}}, "then": {"required": ["kaynaklar"]}},
    {"if": {"properties": {"tur": {"enum": ["fikir", "kaynak", "yansima", "arastirma-notu", "alan-paketi"]}}}, "then": {"required": ["guven"]}},
    {"if": {"properties": {"tur": {"enum": ["gozlem", "yansima"]}}}, "then": {"required": ["onem"]}},
    {"if": {"properties": {"tur": {"const": "fikir"}}}, "then": {"required": ["merdiven", "cynefin"]}},
    {"if": {"properties": {"tur": {"enum": ["karar", "kural", "kapi"]}}}, "then": {"required": ["kapi", "karar_veren"]}},
    {"if": {"properties": {"tur": {"enum": ["kural", "yonerge"]}}}, "then": {"required": ["sunset"]}},
    {"if": {"properties": {"tur": {"const": "yonerge"}}}, "then": {"required": ["dayanak"]}},
    {"if": {"properties": {"tur": {"enum": ["gorev", "rol", "sop"]}}}, "then": {"required": ["sahip"]}},
    {"if": {"properties": {"tur": {"const": "gorev"}}}, "then": {"required": ["inceleyici", "kanban", "kanit", "insan_noktalari", "kapi"]}},
    {"if": {"properties": {"tur": {"const": "kapi"}}}, "then": {"required": ["bekci", "sonuc"]}},
    {"if": {"properties": {"kat": {"const": 3}}}, "then": {"required": ["saklama"]}},
    {"if": {"properties": {"durum": {"not": {"const": "taslak"}}}}, "then": {"required": ["guncelleme"]}},
    {"if": {"properties": {"durum": {"const": "yerine-gecildi"}}}, "then": {"required": ["yerine_gecen"]}}
  ]
}
